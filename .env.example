# Token do seu bot do Discord (obtenha em https://discord.com/developers/applications)
BOT_TOKEN=
PREFIX=e.

# Opcional: servidor/canal usados como fallback quando não há banco de dados
GUILD_ID=
CHANNEL_ID=

# Opcional: persiste snapshots, pesquisas, notícias e fontes
MONGO_URI=
DATABASE_NAME=elections

# Intervalos em segundos: painel vivo no canal e ciclo de alertas
PANEL_REFRESH=10
REFRESH_INTERVAL=20

# Bolão: 100 = apostas abertas até o resultado oficial; defina outro % das urnas para fechar antes
BOLAO_CLOSE_PERCENT=100

# RSS separados por vírgula. Vazio usa G1, UOL, CNN Brasil, Agência Brasil, BBC News Brasil e Poder360.
# Para substituir padrão: NEWS_FEEDS=https://exemplo.com/rss.xml,https://outro.com/feed.xml
NEWS_FEEDS=https://g1.globo.com/rss/g1/,https://rss.uol.com.br/feed/noticias.xml,https://www.cnnbrasil.com.br/feed/,https://agenciabrasil.ebc.com.br/rss/ultimasnoticias/feed.xml,https://feeds.bbci.co.uk/portuguese/rss.xml,https://www.poder360.com.br/feed/
NEWS_REFRESH_INTERVAL=15
NEWS_BACKFILL_HOURS=24
NEWS_BACKFILL_LIMIT=10
NEWS_DELIVERY_LIMIT=3

# Catálogo oficial de contas eleitorais do TSE
TSE_FINANCE_YEAR=2024
TSE_CANDIDATES_YEAR=2026
TSE_CATALOG_REFRESH_INTERVAL=720

# Guild e canal legado; novas guildas configuram com /config
GUILD_ID=
CHANNEL_ID=

# Intervalo de atualização automática em segundos (mínimo recomendado: 15)
REFRESH_INTERVAL=20
